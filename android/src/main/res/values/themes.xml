<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Always dark — better contrast for QR scan/display. -->
    <style name="Theme.ParitySigner" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">#FFE0E0E4</item>
        <item name="colorPrimaryVariant">#FF0D0D12</item>
        <item name="colorOnPrimary">#FF16161D</item>
        <item name="colorSecondary">#FF707078</item>
        <item name="colorSecondaryVariant">#FF2A2A35</item>
        <item name="colorOnSecondary">#FFE0E0E4</item>
        <item name="android:statusBarColor" tools:targetApi="l">#FF0D0D12</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Theme.ParitySigner.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

</resources>
